# ⚠️ DO NOT COMMIT YOUR ACTUAL ENVIRONMENT VARIABLES (.env) TO GITHUB ⚠️
# Use this file as a template: copy it to `.env` and fill in the values.

# --- REQUIRED CORE TELEGRAM BOT CONFIGURATION ---
API_ID=
API_HASH=
TOKEN=

# --- DATABASE CONFIGURATION ---
# MongoDB URI for storing bot data (Required)
MONGO_URI=
DB_NAME=MusicBot

# --- SESSIONS / USERBOT CONFIGURATION ---
# Session strings for assistant/userbot. You can define either SESSION_STRINGS (comma/space-separated) or individual STRING1, STRING2, etc.
SESSION_STRINGS=
SESSION_TYPE=pyrogram

# Individual session string fallbacks
STRING1=
STRING2=
STRING3=
STRING4=
STRING5=

# --- API INTEGRATIONS & SERVICES ---
API_URL=https://tgmusic.fallenapi.fun
API_KEY=

# --- OWNER & LOGGING CONFIGURATION ---
# Owner's Telegram user ID
OWNER_ID=
# Log group/channel ID where bot logs events
LOGGER_ID=
# List of developer Telegram user IDs (comma/space-separated)
DEVS=

# --- DOWNLOADS & CACHING SETTINGS ---
DOWNLOADS_DIR=downloads
DEFAULT_SERVICE=youtube
MAX_FILE_SIZE=524288000
DOWNLOAD_RETENTION_HOURS=24
DOWNLOAD_CLEANUP_INTERVAL_MINUTES=30
DOWNLOAD_CACHE=true
DOWNLOAD_CACHE_MAX_AGE_HOURS=24
DOWNLOAD_CACHE_MAX_SIZE_MB=2048
PREMIUM_QUEUE_LIMIT=50

# --- CONNECTION & TIMEOUTS ---
REQUEST_TIMEOUT_MS=30000
DOWNLOAD_TIMEOUT_MS=180000
YTDLP_TIMEOUT_MS=180000
SONG_DURATION_LIMIT=3600
PROXY=

# --- VOICE CALL SETTINGS ---
VOICE_ADAPTER_COMMAND=python3 scripts/pytgcalls_adapter.py
PORT=8080
AUTO_LEAVE=true
STREAM_DIRECT=false

# --- LYRICS SETTINGS ---
LYRICS_PROVIDER=lrclib
LYRICS_ENABLED_DEFAULT=false
LYRICS_AUTO_START=true
LYRICS_STRICT_TRACK_MATCH=false
LYRICS_PREFETCH_ONLY_WHEN_ENABLED=false
LYRICS_CACHE_TTL_HOURS=24
LYRICS_CACHE_SYNCED_DAYS=30
LYRICS_CACHE_PLAIN_DAYS=7
LYRICS_NOT_FOUND_CACHE_TTL_MINUTES=15
LYRICS_ERROR_CACHE_TTL_MINUTES=1
LYRICS_FETCH_TIMEOUT_MS=12000
LYRICS_FETCH_RETRIES=1
LYRICS_SEARCH_MAX_QUERIES=3
LYRICS_EXACT_MAX_CANDIDATES=3
LYRICS_PREFETCH_TIMEOUT_MS=6000
LYRICS_PREFETCH=true
LYRICS_SYNC_OFFSET_MS=0
LYRICS_MIN_SEND_INTERVAL_MS=1200
LYRICS_TICK_INTERVAL_MS=300
LYRICS_MAX_LINE_LENGTH=300
LYRICS_START_GRACE_SECONDS=1.5
LYRICS_SKIP_OLD_LINE_THRESHOLD_SECONDS=3
LYRICS_DEBUG=false
LYRICS_ENABLE_NETEASE=true
LYRICS_NETEASE_TIMEOUT_MS=8000
LYRICS_ENABLE_SCRAPE_FALLBACK=false
LYRICS_SCRAPE_TIMEOUT_MS=8000
LYRICS_SCRAPE_MAX_BYTES=1000000

# --- SOCIALS & BOT APPEARANCE ---
SUPPORT_GROUP=
SUPPORT_CHANNEL=
SOURCE_URL=
BOT_USERNAME=
START_IMG=
GROUP_START_IMG=
COOKIES_PATH=
COOKIES_URL=
